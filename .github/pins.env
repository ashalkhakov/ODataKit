# What ODataKit builds on, by the exact versions of their releases: the
# workflows (gnustep-release-actions' scripts/deps.sh) and Docker/Dockerfile
# fetch them from here. To move one, edit it here.
#   Linux  each one's archive, unpacked into /opt/gnustep, the stack first
#   Apple  each one's XCFrameworks, and Sparkle's, unpacked into .deps/
#          (FreeCoreData has none: Apple's Core Data is the system's)

# The patched GNUstep stack (ashalkhakov/gnustep-patches).
GNUSTEP_PATCHES_VERSION=2026.10.20.14
# Core Data on GNUstep, with momc (ashalkhakov/FreeCoreData); and the
# PostgreSQL and MySQL stores ois-serve and the tests use, archives of their own.
FREECOREDATA_VERSION=0.11.0
FREECOREDATA_PARTS="postgresql mysql"
# HTTPServerKit's listener (ashalkhakov/GCDWebServer, ported to GNUstep).
GCDWEBSERVER_VERSION=3.5.4.2
# The Workbench's updates on macOS.
SPARKLE_VERSION=2.10.0
