                    <textField focusRingType="none" horizontalCompressionResistancePriority="250" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="LPRED">
                        <rect key="frame" x="12" y="698" width="300" height="16"/>
