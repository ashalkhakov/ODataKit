<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="WBQueryPanel">
            <connections>
                <outlet property="view" destination="QP-root" id="QP-o-view"/>
                <outlet property="aggregateField" destination="AGG" id="oAGG"/>
                <outlet property="batchSizeField" destination="BAT" id="c26"/>
                <outlet property="computeField" destination="COMP" id="oCOMP"/>
                <outlet property="entityPopup" destination="ENT" id="c3"/>
                <outlet property="expandOutline" destination="EXPO" id="oEXPO"/>
                <outlet property="explainButton" destination="EXPL" id="oEXPL"/>
                <outlet property="executeButton" destination="GO" id="oGO"/>
                <outlet property="faultsButton" destination="FLT" id="c10"/>
                <outlet property="groupField" destination="GRP" id="oGRP"/>
                <outlet property="limitField" destination="LIM" id="c8"/>
                <outlet property="predicateView" destination="PRED" id="c9"/>
                <outlet property="resultTypePopup" destination="RES" id="c4"/>
                <outlet property="searchField" destination="SRCH" id="oSRCH"/>
                <outlet property="selectTable" destination="SELT" id="oSELT"/>
                <outlet property="skipField" destination="SKP" id="c25"/>
                <outlet property="sortTable" destination="SORT" id="oSORT"/>
                <outlet property="subentitiesButton" destination="SUB" id="c27"/>
                <outlet property="timeField" destination="TIME" id="oTIME"/>
                <outlet property="wireURLField" destination="WIRE" id="c11"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <!-- WBQueryPanel.xib's controls stacked, a field or a list a row
             (WBQueryPanel -initStacked): for a host narrower than the
             Workbench's window, UDCode's OData builder. Its controls,
             outlets and actions are WBQueryPanel.xib's; keep them alike. -->
        <!-- The query panel (WBQueryPanel): everything a fetch request can
             ask of the store, and the GET it sends. Execute and Explain go
             to the first responder: the Workbench's window controller, or a
             host's editor (UDCode's OData builder). -->
        <customView translatesAutoresizingMaskIntoConstraints="NO" id="QP-root" userLabel="Query Panel">
            <rect key="frame" x="0.0" y="0.0" width="560" height="850"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
            <subviews>
                    <textField focusRingType="none" horizontalCompressionResistancePriority="250" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="LENT">
                        <rect key="frame" x="12" y="820" width="112" height="16"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                        <textFieldCell key="cell" title="Entity" id="LENTC">
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                    <popUpButton fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="ENT">
                        <rect key="frame" x="128" y="816" width="180" height="24"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                        <popUpButtonCell key="cell" type="push" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" borderStyle="borderAndBezel" inset="2" id="ENTC">
                            <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                            <menu key="menu" id="ENTM"/>
                        </popUpButtonCell>
                        <connections>
                            <action selector="entityChanged:" target="-2" id="AENT"/>
                        </connections>
                    </popUpButton>
                    <textField focusRingType="none" horizontalCompressionResistancePriority="250" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="LRES">
                        <rect key="frame" x="320" y="820" width="52" height="16"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                        <textFieldCell key="cell" title="Result" id="LRESC">
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                    <popUpButton fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="RES">
                        <rect key="frame" x="376" y="816" width="172" height="24"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                        <popUpButtonCell key="cell" type="push" title="objects" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" state="on" borderStyle="borderAndBezel" inset="2" selectedItem="R0" id="RESC">
                            <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                            <menu key="menu" id="RESM">
                                <items>
                                    <menuItem title="objects" state="on" id="R0"/>
                                    <menuItem title="object IDs" id="R1"/>
                                    <menuItem title="dictionary" id="R2"/>
                                    <menuItem title="count" id="R3"/>
                                </items>
                            </menu>
                        </popUpButtonCell>
                        <connections>
                            <action selector="queryChanged:" target="-2" id="ARES"/>
                        </connections>
                    </popUpButton>
                    <textField focusRingType="none" horizontalCompressionResistancePriority="250" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="LLIM">
                        <rect key="frame" x="12" y="789" width="112" height="16"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                        <textFieldCell key="cell" title="$top" id="LLIMC">
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                    <textField focusRingType="none" horizontalCompressionResistancePriority="250" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="LIM">
                        <rect key="frame" x="128" y="786" width="60" height="22"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                        <textFieldCell key="cell" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" state="on" borderStyle="bezel" placeholderString="∞" drawsBackground="YES" id="LIMC">
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
