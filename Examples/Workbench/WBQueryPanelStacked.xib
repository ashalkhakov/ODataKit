                            <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                    <scrollView fixedFrame="YES" autohidesScrollers="YES" horizontalLineScroll="17" horizontalPageScroll="10" verticalLineScroll="17" verticalPageScroll="10" hasHorizontalScroller="NO" translatesAutoresizingMaskIntoConstraints="NO" id="SORTS">
                        <rect key="frame" x="12" y="510" width="496" height="100"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                        <clipView key="contentView" id="SORTCL">
                            <rect key="frame" x="1" y="1" width="494" height="98"/>
                            <autoresizingMask key="autoresizingMask"/>
                            <subviews>
                                <tableView columnAutoresizingStyle="firstColumnOnly" multipleSelection="NO" headerView="SORTH" id="SORT">
                                    <rect key="frame" x="0" y="0" width="494" height="75"/>
                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                    <tableColumns>
                                        <tableColumn identifier="key" width="438" minWidth="16" maxWidth="1000" id="SORTK">
                                            <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" title="key path"/>
                                            <textFieldCell key="dataCell" selectable="YES" editable="YES" id="SORTKD">
