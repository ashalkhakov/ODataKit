                        <connections>
                            <outlet property="delegate" destination="-2" id="TIMED"/>
                        </connections>
                    </textField>
                    <textField focusRingType="none" horizontalCompressionResistancePriority="250" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="LSORT">
                        <rect key="frame" x="12" y="614" width="400" height="16"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                        <textFieldCell key="cell" title="Sort ($orderby): key paths, first first" id="LSORTC">
