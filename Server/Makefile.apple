# ois-serve, an example application of its own (catalog-server), the
# permissions checker (odatakit-permissions), and the loopback check: tools over the libraries at the repository root
# (OTelKit, HTTPServerKit, ODataService), which are built there first.
#
# macOS (Apple Foundation and Core Data), without gnustep-make (this file):
#   make -f Makefile.apple && make -f Makefile.apple check
#                               # plain clang; the libraries' sources are
#                               # compiled into the tools, linked with
#                               # GCDWebServer's XCFramework in ../.deps
# GNUstep: GNUmakefile.

INCLUDE_DIRS = -I../Source/ODataKit/include -I../Source/ODataIncrementalStore/include -I../Source/ODataService/include \
	-I../Source/HTTPServerKit/include -I../Source/ODataKit/include/ODataKit \
	-I../Source/ODataIncrementalStore/include/ODataIncrementalStore -I../Source/ODataService/include/ODataService \
	-I../Source/HTTPServerKit/include/HTTPServerKit -I../Source/OTelKit/include -I../Source/OTelKit/include/OTelKit \
	-I../Source/ODataSync/include -I../Source/ODataSync/include/ODataSync

CC = clang
BUILD_DIR = build
# The version httpserverkit_build_info says.
HTTPSERVERKIT_VERSION ?= $(shell git -C "$(CURDIR)" describe --tags --always 2>/dev/null || echo dev)
FLAGS = -fobjc-arc -fblocks -fobjc-exceptions -Wall -Wno-unused-parameter -DHTTPSERVERKIT_VERSION='"$(HTTPSERVERKIT_VERSION)"'
GCDWEBSERVER = ../.deps/GCDWebServer.xcframework/macos-arm64_x86_64
INCLUDES = $(INCLUDE_DIRS) -I$(GCDWEBSERVER)/Headers
LIBS = -ObjC $(GCDWEBSERVER)/libGCDWebServer.a -framework Foundation -framework CoreData -framework Security -framework Network -framework SystemConfiguration \
	-framework CoreServices -lz
# What differs by system is in each library's apple/ (and linux/, which
# the GNUstep build compiles): this is Apple's.
SOURCES = $(wildcard ../Source/*/*.m ../Source/*/apple/*.m)
HEADERS = $(wildcard ../Source/*/include/*/*.h ../Source/*/*.h ../Source/*/apple/*.h)

all: $(BUILD_DIR)/ois-serve $(BUILD_DIR)/ois-serve-check $(BUILD_DIR)/catalog-server $(BUILD_DIR)/odatakit-permissions

$(BUILD_DIR)/ois-serve: ois-serve.m $(SOURCES) $(HEADERS)
	@mkdir -p $(BUILD_DIR)
	$(CC) $(FLAGS) $(INCLUDES) ois-serve.m $(SOURCES) $(LIBS) -o $@

$(BUILD_DIR)/catalog-server: Examples/CatalogServer.m $(SOURCES) $(HEADERS)
	@mkdir -p $(BUILD_DIR)
	$(CC) $(FLAGS) $(INCLUDES) Examples/CatalogServer.m $(SOURCES) $(LIBS) -o $@

$(BUILD_DIR)/ois-serve-check: Tests/ois-serve-check.m Tests/posix/OISSockets.m Tests/OISSockets.h $(SOURCES) $(HEADERS)
	@mkdir -p $(BUILD_DIR)
	$(CC) $(FLAGS) $(INCLUDES) Tests/ois-serve-check.m Tests/posix/OISSockets.m $(SOURCES) $(LIBS) -o $@

$(BUILD_DIR)/odatakit-permissions: odatakit-permissions.m $(SOURCES) $(HEADERS)
	@mkdir -p $(BUILD_DIR)
	$(CC) $(FLAGS) $(INCLUDES) odatakit-permissions.m $(SOURCES) $(LIBS) -o $@

# The checker as a release ships it (../Makefile.apple install): both of
# the Mac's architectures, for the macOS the frameworks are for.
$(BUILD_DIR)/universal/odatakit-permissions: odatakit-permissions.m $(SOURCES) $(HEADERS)
	@mkdir -p $(dir $@)
	$(CC) -arch arm64 -arch x86_64 -mmacosx-version-min=12.0 $(FLAGS) $(INCLUDES) odatakit-permissions.m $(SOURCES) $(LIBS) -o $@

$(BUILD_DIR)/Catalog.momd: ../Examples/Catalog/Catalog.xcdatamodeld
	@mkdir -p $(BUILD_DIR)
	rm -rf $@ && xcrun momc $< $(abspath $@)

check: all $(BUILD_DIR)/Catalog.momd
	./$(BUILD_DIR)/ois-serve-check $(BUILD_DIR)/Catalog.momd
	./$(BUILD_DIR)/odatakit-permissions check $(BUILD_DIR)/Catalog.momd Examples/Catalog.permissions.plist
	! ./$(BUILD_DIR)/odatakit-permissions check $(BUILD_DIR)/Catalog.momd Tests/Unfit.permissions.plist

clean:
	rm -rf $(BUILD_DIR)

.PHONY: all check clean

