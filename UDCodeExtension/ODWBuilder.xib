<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="ODWBuilderViewController">
            <connections>
                <outlet property="view" destination="QB-root" id="QB-o-view"/>
                <outlet property="servicePopup" destination="QB-service" id="QB-o-service"/>
                <outlet property="connectButton" destination="QB-connect" id="QB-o-connect"/>
                <outlet property="statusLabel" destination="QB-status" id="QB-o-status"/>
                <outlet property="kindPopup" destination="QB-kind" id="QB-o-kind"/>
                <outlet property="targetLabel" destination="QB-target-label" id="QB-o-target-label"/>
                <outlet property="targetPopup" destination="QB-target" id="QB-o-target"/>
                <outlet property="contentHost" destination="QB-content" id="QB-o-content"/>
                <outlet property="fieldsSection" destination="QB-fields" id="QB-o-fields"/>
                <outlet property="fieldsLabel" destination="QB-fields-label" id="QB-o-fields-label"/>
                <outlet property="fieldsTable" destination="QB-fields-table" id="QB-o-fields-table"/>
                <outlet property="bodySection" destination="QB-body" id="QB-o-body"/>
                <outlet property="bodyView" destination="QB-body-text" id="QB-o-body-text"/>
                <outlet property="panelScroll" destination="QB-panel-scroll" id="QB-o-panel-scroll"/>
                <outlet property="panelHost" destination="QB-panel-host" id="QB-o-panel-host"/>
                <outlet property="requestLine" destination="QB-line" id="QB-o-line"/>
                <outlet property="executeButton" destination="QB-execute" id="QB-o-execute"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <!-- An .odataq document's tab (ODWBuilderViewController): the service
             it is sent to; what kind of request it is (a query, an entity
             created, updated or deleted, a function or action called) and
             of what; then the fields it asks for (a key, parameters), and
             the Workbench's query panel (a query: WBQueryPanel, put in its
             host from code) or a body (JSON); the request as sent, shown as
             curl, copied as curl, sent. The sections in the content host
             are placed from code, by the kind. -->
        <customView id="QB-root" customClass="ODWBuilderView" userLabel="Query Builder">
            <rect key="frame" x="0.0" y="0.0" width="1100" height="420"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <textField verticalHuggingPriority="750" id="QB-service-label">
                    <rect key="frame" x="14" y="392" width="76" height="17"/>
                    <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                    <textFieldCell key="cell" lineBreakMode="clipping" title="Service:" id="QB-service-label-cell">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <popUpButton verticalHuggingPriority="750" id="QB-service">
                    <rect key="frame" x="92" y="386" width="220" height="26"/>
                    <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                    <popUpButtonCell key="cell" type="push" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" borderStyle="borderAndBezel" inset="2" id="QB-service-cell">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                        <menu key="menu" id="QB-service-menu"/>
                    </popUpButtonCell>
                    <connections>
                        <action selector="serviceChosen:" target="-2" id="QB-a-service"/>
                    </connections>
                </popUpButton>
                <button verticalHuggingPriority="750" id="QB-connect">
                    <rect key="frame" x="314" y="384" width="96" height="32"/>
                    <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="push" title="Connect" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="QB-connect-cell">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="connectService:" target="-2" id="QB-a-connect"/>
                    </connections>
                </button>
                <textField verticalHuggingPriority="750" id="QB-status">
                    <rect key="frame" x="416" y="392" width="670" height="17"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" lineBreakMode="truncatingTail" selectable="YES" title="Choose the service to send the request to." id="QB-status-cell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <textField verticalHuggingPriority="750" id="QB-kind-label">
                    <rect key="frame" x="14" y="360" width="76" height="17"/>
                    <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                    <textFieldCell key="cell" lineBreakMode="clipping" title="Request:" id="QB-kind-label-cell">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <!-- Its items' tags are ODWBuilderKind's. -->
                <popUpButton verticalHuggingPriority="750" id="QB-kind">
                    <rect key="frame" x="92" y="354" width="220" height="26"/>
                    <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                    <popUpButtonCell key="cell" type="push" title="Query (GET)" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" state="on" borderStyle="borderAndBezel" inset="2" selectedItem="QB-kind-query" id="QB-kind-cell">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                        <menu key="menu" id="QB-kind-menu">
                            <items>
                                <menuItem title="Query (GET)" state="on" id="QB-kind-query"/>
                                <menuItem title="Create (POST)" tag="1" id="QB-kind-create"/>
                                <menuItem title="Update (PATCH)" tag="2" id="QB-kind-update"/>
                                <menuItem title="Delete (DELETE)" tag="3" id="QB-kind-delete"/>
                                <menuItem title="Call a Function or Action" tag="4" id="QB-kind-call"/>
                            </items>
                        </menu>
                    </popUpButtonCell>
                    <connections>
                        <action selector="kindChosen:" target="-2" id="QB-a-kind"/>
                    </connections>
                </popUpButton>
                <textField verticalHuggingPriority="750" id="QB-target-label">
                    <rect key="frame" x="324" y="360" width="80" height="17"/>
                    <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                    <textFieldCell key="cell" lineBreakMode="clipping" alignment="right" title="Entity set:" id="QB-target-label-cell">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <popUpButton verticalHuggingPriority="750" id="QB-target">
                    <rect key="frame" x="408" y="354" width="260" height="26"/>
                    <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                    <popUpButtonCell key="cell" type="push" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" borderStyle="borderAndBezel" inset="2" id="QB-target-cell">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                        <menu key="menu" id="QB-target-menu"/>
                    </popUpButtonCell>
                    <connections>
                        <action selector="targetChosen:" target="-2" id="QB-a-target"/>
                    </connections>
                </popUpButton>
                <customView id="QB-content" userLabel="Content (its sections placed by the kind)">
                    <rect key="frame" x="0.0" y="48" width="1100" height="298"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                    <subviews>
                        <!-- A key's fields, or a call's parameters: a row each. -->
                        <customView id="QB-fields" userLabel="Fields">
                            <rect key="frame" x="0.0" y="196" width="1100" height="102"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                            <subviews>
                                <textField verticalHuggingPriority="750" id="QB-fields-label">
                                    <rect key="frame" x="14" y="84" width="560" height="16"/>
                                    <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                                    <textFieldCell key="cell" lineBreakMode="truncatingTail" title="Key" id="QB-fields-label-cell">
                                        <font key="font" metaFont="system"/>
                                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                    </textFieldCell>
                                </textField>
                                <scrollView autohidesScrollers="YES" horizontalLineScroll="18" horizontalPageScroll="10" verticalLineScroll="18" verticalPageScroll="10" hasHorizontalScroller="NO" id="QB-fields-scroll">
                                    <rect key="frame" x="14" y="0.0" width="560" height="80"/>
                                    <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                                    <clipView key="contentView" id="QB-fields-clip">
                                        <rect key="frame" x="1" y="1" width="558" height="78"/>
                                        <autoresizingMask key="autoresizingMask"/>
                                        <subviews>
                                            <tableView columnAutoresizingStyle="lastColumnOnly" multipleSelection="NO" autosaveColumns="NO" rowHeight="18" headerView="QB-fields-header" id="QB-fields-table">
                                                <rect key="frame" x="0.0" y="0.0" width="558" height="55"/>
                                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                <tableColumns>
                                                    <tableColumn identifier="name" editable="NO" width="200" minWidth="40" maxWidth="1000" id="QB-fields-name">
                                                        <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" title="name"/>
                                                        <textFieldCell key="dataCell" lineBreakMode="truncatingTail" selectable="YES" id="QB-fields-name-cell">
                                                            <font key="font" metaFont="system"/>
                                                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                            <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                        </textFieldCell>
                                                    </tableColumn>
                                                    <tableColumn identifier="value" width="352" minWidth="40" maxWidth="2000" id="QB-fields-value">
                                                        <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" title="value"/>
                                                        <textFieldCell key="dataCell" lineBreakMode="truncatingTail" selectable="YES" editable="YES" id="QB-fields-value-cell">
                                                            <font key="font" metaFont="system"/>
                                                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                            <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                        </textFieldCell>
                                                    </tableColumn>
                                                </tableColumns>
                                                <connections>
                                                    <outlet property="dataSource" destination="-2" id="QB-fields-ds"/>
                                                    <outlet property="delegate" destination="-2" id="QB-fields-dl"/>
                                                </connections>
                                            </tableView>
                                        </subviews>
                                    </clipView>
                                    <scroller key="verticalScroller" verticalHuggingPriority="750" horizontal="NO" id="QB-fields-vs">
                                        <autoresizingMask key="autoresizingMask" flexibleMinX="YES" heightSizable="YES"/>
                                    </scroller>
                                    <tableHeaderView key="headerView" id="QB-fields-header">
                                        <rect key="frame" x="0.0" y="0.0" width="558" height="23"/>
                                        <autoresizingMask key="autoresizingMask" flexibleMinY="YES" flexibleMaxY="YES"/>
                                    </tableHeaderView>
                                </scrollView>
                            </subviews>
                        </customView>
                        <!-- A body: JSON, as sent. -->
                        <customView id="QB-body" userLabel="Body">
                            <rect key="frame" x="0.0" y="0.0" width="1100" height="188"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                            <subviews>
                                <textField verticalHuggingPriority="750" id="QB-body-label">
                                    <rect key="frame" x="14" y="170" width="560" height="16"/>
                                    <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                                    <textFieldCell key="cell" lineBreakMode="truncatingTail" title="Body (JSON)" id="QB-body-label-cell">
                                        <font key="font" metaFont="system"/>
                                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                    </textFieldCell>
                                </textField>
                                <scrollView autohidesScrollers="YES" horizontalLineScroll="10" horizontalPageScroll="10" verticalLineScroll="10" verticalPageScroll="10" hasHorizontalScroller="NO" id="QB-body-scroll">
                                    <rect key="frame" x="14" y="0.0" width="1072" height="166"/>
                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                    <clipView key="contentView" id="QB-body-clip">
                                        <rect key="frame" x="1" y="1" width="1070" height="164"/>
                                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                        <subviews>
                                            <textView importsGraphics="NO" richText="NO" verticallyResizable="YES" allowsUndo="YES" id="QB-body-text">
                                                <rect key="frame" x="0.0" y="0.0" width="1070" height="164"/>
                                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                                <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                <size key="minSize" width="1070" height="164"/>
                                                <size key="maxSize" width="10000" height="10000000"/>
                                                <connections>
                                                    <outlet property="delegate" destination="-2" id="QB-body-dl"/>
                                                </connections>
                                            </textView>
                                        </subviews>
                                    </clipView>
                                    <scroller key="verticalScroller" verticalHuggingPriority="750" horizontal="NO" id="QB-body-vs">
                                        <autoresizingMask key="autoresizingMask" flexibleMinX="YES" heightSizable="YES"/>
                                    </scroller>
                                </scrollView>
                            </subviews>
                        </customView>
                        <!-- A query: the panel at its own size, put at the top of
                             the host (flipped) from code; a tab narrower or
                             shorter than it scrolls rather than pushes its
                             controls together. -->
                        <scrollView borderType="none" autohidesScrollers="YES" horizontalLineScroll="10" horizontalPageScroll="10" verticalLineScroll="10" verticalPageScroll="10" id="QB-panel-scroll">
                            <rect key="frame" x="0.0" y="0.0" width="1100" height="188"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                            <clipView key="contentView" drawsBackground="NO" id="QB-panel-clip">
                                <rect key="frame" x="0.0" y="0.0" width="1100" height="188"/>
                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                <subviews>
                                    <customView id="QB-panel-host" customClass="ODWPanelHostView" userLabel="Query Panel">
                                        <rect key="frame" x="0.0" y="0.0" width="1100" height="188"/>
                                        <autoresizingMask key="autoresizingMask"/>
                                    </customView>
                                </subviews>
                            </clipView>
                            <scroller key="horizontalScroller" verticalHuggingPriority="750" horizontal="YES" id="QB-panel-hs">
                                <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                            </scroller>
                            <scroller key="verticalScroller" verticalHuggingPriority="750" horizontal="NO" id="QB-panel-vs">
                                <autoresizingMask key="autoresizingMask" flexibleMinX="YES" heightSizable="YES"/>
                            </scroller>
                        </scrollView>
                    </subviews>
                </customView>
                <!-- The request as it is sent; shown and copied as curl. -->
                <textField verticalHuggingPriority="750" id="QB-line">
                    <rect key="frame" x="14" y="8" width="726" height="32"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES"/>
                    <textFieldCell key="cell" lineBreakMode="charWrapping" selectable="YES" title="GET" id="QB-line-cell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <button verticalHuggingPriority="750" id="QB-show-curl">
                    <rect key="frame" x="746" y="8" width="110" height="32"/>
                    <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMaxY="YES"/>
                    <buttonCell key="cell" type="push" title="Show curl" bezelStyle="rounded" alignment="center" borderStyle="border" inset="2" id="QB-show-curl-cell">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="showCurl:" target="-2" id="QB-a-show-curl"/>
                    </connections>
                </button>
                <button verticalHuggingPriority="750" id="QB-copy-curl">
                    <rect key="frame" x="860" y="8" width="110" height="32"/>
                    <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMaxY="YES"/>
                    <buttonCell key="cell" type="push" title="Copy curl" bezelStyle="rounded" alignment="center" borderStyle="border" inset="2" id="QB-copy-curl-cell">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="copyCurl:" target="-2" id="QB-a-copy-curl"/>
                    </connections>
                </button>
                <button verticalHuggingPriority="750" id="QB-execute">
                    <rect key="frame" x="976" y="8" width="110" height="32"/>
                    <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMaxY="YES"/>
                    <buttonCell key="cell" type="push" title="Execute" bezelStyle="rounded" alignment="center" borderStyle="border" inset="2" id="QB-execute-cell">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="runFetch:" target="-2" id="QB-a-execute"/>
                    </connections>
                </button>
            </subviews>
            <connections>
                <outlet property="controller" destination="-2" id="QB-o-controller"/>
            </connections>
        </customView>
    </objects>
</document>
